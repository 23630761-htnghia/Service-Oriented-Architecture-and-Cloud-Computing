{
  "name": "smartlive-comment-delta-pipeline",
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "existing_cluster_id": "<existing-cluster-id>",
      "notebook_task": {
        "notebook_path": "/Shared/smartlive-databricks/01_ingest_sync_records",
        "base_parameters": {
          "input_path": "dbfs:/FileStore/smartlive/raw/sync_records_sample.json",
          "bronze_table": "main.default.smartlive_sync_comments_bronze",
          "shuffle_partitions": "8"
        }
      },
      "timeout_seconds": 0
    },
    {
      "task_key": "silver_etl",
      "depends_on": [
        {
          "task_key": "bronze_ingestion"
        }
      ],
      "existing_cluster_id": "<existing-cluster-id>",
      "notebook_task": {
        "notebook_path": "/Shared/smartlive-databricks/02_transform_to_silver",
        "base_parameters": {
          "bronze_table": "main.default.smartlive_sync_comments_bronze",
          "silver_table": "main.default.smartlive_sync_comments_silver",
          "target_partitions": "8"
        }
      },
      "timeout_seconds": 0
    },
    {
      "task_key": "gold_reporting",
      "depends_on": [
        {
          "task_key": "silver_etl"
        }
      ],
      "existing_cluster_id": "<existing-cluster-id>",
      "notebook_task": {
        "notebook_path": "/Shared/smartlive-databricks/03_build_gold_metrics",
        "base_parameters": {
          "silver_table": "main.default.smartlive_sync_comments_silver",
          "gold_table": "main.default.smartlive_daily_metrics_gold"
        }
      },
      "timeout_seconds": 0
    }
  ]
}
